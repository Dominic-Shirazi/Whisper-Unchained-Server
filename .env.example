# Where transcription runs (Settings > Transcription):
#   local  = this PC runs Whisper (the settings below)
#   remote = another PC running Whisper Unchained Server; it applies its own
#            vocabulary, "prompt AI" commands and cleanup
#   cloud  = an OpenAI-compatible service (Groq, OpenAI, ...) with your key;
#            vocabulary sent as hints, name corrections + filler removal run here
TRANSCRIBE_SOURCE=local
# remote: the other PC's base URL ending in /v1, and its key if it has one
REMOTE_SERVER_URL=
REMOTE_API_KEY=
# cloud: groq | openai | custom (Settings fills address + model for presets)
CLOUD_PROVIDER=groq
CLOUD_BASE_URL=https://api.groq.com/openai/v1
CLOUD_API_KEY=
CLOUD_MODEL=whisper-large-v3-turbo

# Faster-Whisper Model Settings
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v1, large-v2, large-v3, large-v3-turbo, distil-large-v2, distil-medium.en, distil-small.en, distil-large-v3
# Recommended: large-v3-turbo (~2.1 GB VRAM fp16; near large-v3 accuracy at about half
# the latency). Smaller GPUs or CPU-only: small.en (~0.6 GB).
WHISPER_MODEL_SIZE=large-v3-turbo
# Options: auto, cuda, cpu
# auto (and cuda) use an NVIDIA graphics card when one works, else the processor
# (AMD and Intel graphics can't run faster-whisper). The server falls back to the
# processor with int8 rather than failing, and /health says why. cpu: always.
WHISPER_DEVICE=auto
# Processor threads (blank = one per physical core, at most 8).
# WHISPER_CPU_THREADS=
# Folder the service loads Whisper models from (relative = inside this project).
# Shared with the Settings window's model picker, so it can show what's downloaded
# and fetch a model BEFORE you switch (the service's own cache is unreadable).
WHISPER_MODELS_DIR=models

# Remove standalone um / umm / uh / uhh / hmm from dictation (never 'like').
# Removals are logged as FILL lines in api/transcripts.log.
REMOVE_FILLERS=false

# Dictation cleanup: one pass through the edit model (AI Editing backend) that
# removes fillers, applies "no wait, I mean" corrections and spoken formatting.
# Off by default; skipped when a "prompt AI" trigger fires. A request can ask for
# it with processing=clean (the phone's cleanup switch) and override the style.
CLEANUP_ALWAYS=false
# standard | light | minimal
CLEANUP_PUNCTUATION=standard
# keep (only remove fillers) | fix (grammar) | polish
CLEANUP_REWRITE=keep
# off | light | strong
CLEANUP_SHORTEN=off
# neutral | professional | casual | friendly (only with rewrite fix/polish)
CLEANUP_TONE=neutral
CLEANUP_EMOJI=false

# --- Hallucination / low-confidence filtering -------------------------------
# Whisper invents filler ("Thank you.", "I don't know.") over silence, and can
# loop ("I'm I'm I'm..."). VAD + these per-segment confidence gates drop it.
# A segment is cut as silence only if its no-speech prob is ABOVE this AND its
# decode confidence is BELOW the logprob threshold (both required, so real quiet
# words survive). Raise NO_SPEECH_THRESHOLD toward 1.0 to filter less.
NO_SPEECH_THRESHOLD=0.6
LOGPROB_THRESHOLD=-1.0
# A segment whose text compresses past this ratio (i.e. is very repetitive) is
# treated as a decode loop and dropped. Normal speech stays well under 2.4.
COMPRESSION_RATIO_THRESHOLD=2.4
# Log every raw+final transcript to api/transcripts.log to build a corpus of your
# own speech for tuning triggers/prompts. Off by default: it keeps everything you
# dictate. Settings > Audio Corpus turns it on and can delete the history.
LOG_TRANSCRIPTS=false

# --- Background-noise denoise (experimental, off by default) -----------------
# When true, every clip is ALSO run through DeepFilterNet and transcribed twice;
# whichever pass the decoder is more confident about is returned. It can only
# help (the raw pass wins if denoise hurt), at the cost of ~0.7s + one extra
# decode per clip. Helps a phone call / voice memo held close in a loud room;
# it cannot fix a phone flat on a table (that's competing speech, not noise).
# Requires the deep-filter binary in api/bin/ (not vendored -- download it):
#   curl -L -o api/bin/deep-filter.exe \
#     https://github.com/Rikorose/DeepFilterNet/releases/download/v0.5.6/deep-filter-0.5.6-x86_64-pc-windows-msvc.exe
DENOISE_ENABLED=false
# Override the binary path if you put it elsewhere.
# DENOISE_BIN=api/bin/deep-filter.exe
# Attenuation limit in dB (deep-filter -a): 100 = full reduction, lower = gentler.
DENOISE_ATTEN_LIMIT_DB=100

# Windows Service Configuration
# Whether to run the API as a background service (false) or visible console window (true)
API_VISIBLE=false

# How often to restart the background service to clear VRAM (in hours)
RESTART_INTERVAL_HOURS=4

# Client Configuration
# Where the background listener and file-transcriber send audio for transcription.
# Leave unset to use the local API. Point it at a remote whisper server to run the
# client on one machine and the API on another (e.g. a Tailscale 100.x address):
#   WHISPER_API_URL=http://100.x.y.z:5000/transcribe
# WHISPER_API_URL=http://127.0.0.1:5000/transcribe

# API key. The setup wizard creates one, and it's required by default: every
# route except GET /health then needs "Authorization: Bearer <key>". The desktop
# listener and file-transcriber read it from this file automatically, the phone
# gets it by QR pairing. WHISPER_API_KEY_REQUIRED=false keeps the key saved but
# lets anything on your network or Tailscale use the server without it (devices
# that send the key keep working). Settings > Connections has both. Generate one with:
#   .venv\Scripts\python.exe -c "import secrets; print('wr_sec_' + secrets.token_urlsafe(24))"
#
# Encrypted keys: on Windows, Settings and the tray save every *_API_KEY here
# as "dpapi:<long base64>" (Windows DPAPI, this-PC scope). That keeps the key
# out of a copied .env, a backup or a screenshot; programs running on this PC
# can still decrypt it. A plain key typed in by hand still works and gets
# encrypted the next time Settings saves or the tray starts. A dpapi: value only
# works on the PC that made it: after moving .env to another PC (or to Linux,
# which stores keys as plain text), enter the keys again.
# WHISPER_API_KEY=
WHISPER_API_KEY_REQUIRED=true

# Keep dictations out of Windows clipboard history (Win+V) and cloud clipboard.
# May stop pasting into Chrome Remote Desktop.
CLIPBOARD_PRIVATE=false

# Dictation hotkey (keyboard-library names: `, f9, pause, ctrl+alt+space, ...).
# Keys that type nothing are best; the backtick types a ` that gets deleted before
# pasting. Mode: toggle = tap to start / tap to stop, hold = push-to-talk (needs a
# key that types nothing). Apply with "Restart Listener" in the tray.
HOTKEY=f9
HOTKEY_MODE=toggle

# Two ports, one server. Change them in Settings > Connections (Save & Restart
# API updates the service and firewall too), or re-run scripts/install_service.ps1.
#
# Encrypted (HTTPS) port, for phones and other PCs. The server makes its own
# certificate (api/certs/) and the pairing QR carries its fingerprint, so the
# phone trusts exactly this PC. Phone app 1.3 or newer. Changing it needs
# "Save & Restart API" and a new scan of the pairing code.
SERVER_HTTPS=true
WHISPER_HTTPS_PORT=5001

# Unencrypted (plain HTTP) port, for other programs on your network that can't
# use this PC's own certificate (most self-hosted AI tools). Only answers this
# PC, the local network and Tailscale. Off for new installs; a missing line
# means on, as before.
SERVER_PLAIN_HTTP=false
WHISPER_API_PORT=5000

# Game mode: pause dictation and free the GPU while a game runs full screen;
# resumes when you stop. GAME_PROCESSES adds programs that run windowed.
GAME_MODE=false
GAME_PROCESSES=

# Startup delay for the listener to wait for API
LISTEN_DELAY_SECONDS=10

# How many minutes of inactivity before the background listener gracefully restarts itself
LISTENER_RESTART_INTERVAL_MINS=30

# When pasting into a Chrome Remote Desktop window, the listener nudges CRD's
# focus to force it to sync the clipboard to the remote machine, then waits this
# many seconds before sending Ctrl+V. Increase it on slow/laggy connections.
CRD_SYNC_DELAY_SECONDS=0.6

# Say 'prompt ai' while recording to give the a LLM instuctions on the requested transcription
# Local LLM API URL for Fast-Path processing
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
# Optional: run the base 'prompt ai' editor on a separate machine. Falls back to
# OLLAMA_API_URL when unset. If the API runs as a LocalSystem Windows service,
# use an IP (e.g. a Tailscale 100.x address), not a bare hostname, the service
# context often can't resolve short/MagicDNS names.
# OLLAMA_EDIT_API_URL=http://100.x.y.z:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# Optional: send 'prompt ai' edits to an OpenAI-compatible server (llama.cpp,
# vLLM, LM Studio...) instead of Ollama. When set, OLLAMA_EDIT_API_URL and
# OLLAMA_MODEL are ignored for edits and the Ollama preload is skipped.
# Edit backend: ollama (OLLAMA_EDIT_API_URL + OLLAMA_MODEL) or openai (any
# OpenAI-compatible server/cloud: EDIT_LLM_BASE_URL + EDIT_LLM_MODEL + EDIT_LLM_API_KEY).
# Unset = openai when EDIT_LLM_BASE_URL is set, else ollama.
# EDIT_BACKEND=ollama
# EDIT_LLM_BASE_URL=http://192.168.x.y:8081/v1
# EDIT_LLM_MODEL=your-model-name
# EDIT_LLM_API_KEY=
# Reasoning models: true sends chat_template_kwargs.enable_thinking=false.
# EDIT_LLM_NO_THINK=true
# EDIT_LLM_TIMEOUT_SECONDS=60
# How long Ollama holds the edit model in VRAM after a request.
#   -1  = until unloaded manually (`ollama stop <model>`)
#    0  = unload right after each request
#   300 / 30m = seconds or a duration string (Ollama's own default is 5m)
# -1 trades resident VRAM (~7.5 GB for a 7B q4 with its KV cache, more than the
# 4.7 GB on disk) for a warm model, so every request after the first skips the
# load that dominates time-to-first-token (measured here: 5.5s -> 0.85s).
# Only worth it when the editor runs on the local box; drop it to 0 if Whisper
# starts falling back to CPU or Ollama begins evicting models.
OLLAMA_EDIT_KEEP_ALIVE=-1
# Preload + pin the edit model on every API start (boot and each
# RESTART_INTERVAL_HOURS restart). false = load on first use instead.
OLLAMA_EDIT_PRELOAD=true
# 'Mean mode' (prompt roast / prompt tiktok / prompt disses) can use any server:
#   MEAN_BACKEND=ollama  OLLAMA_API_URL + OLLAMA_ROAST_MODEL below (default)
#   MEAN_BACKEND=edit    the same server and model as AI Editing
#   MEAN_BACKEND=openai  any OpenAI-compatible server: MEAN_LLM_BASE_URL (ending
#                        in /v1), MEAN_LLM_MODEL, MEAN_LLM_API_KEY, MEAN_LLM_NO_THINK
# A model that won't refuse helps. Tested 2026-11-10: Bonsai2 27B (no-think) best,
# qwen2.5-abliterate 7B fine and fast. For the Ollama default, pull it first:
#   ollama pull huihui_ai/qwen2.5-abliterate:7b
MEAN_BACKEND=ollama
OLLAMA_ROAST_MODEL=huihui_ai/qwen2.5-abliterate:7b
# Roast runs locally on a reasoning model that cold-loads into VRAM already held by
# Whisper, so a roast fired right after dictating can be much slower than a warm run
# (~30s). If roasts time out and paste back your raw words with no roast, raise this.
ROAST_TIMEOUT_SECONDS=300

# --- Rolling audio corpus ----------------------------------------------------
# Keep the last N source clips in api/audio_corpus/ for model A/B testing.
# Clips moved into api/audio_corpus/keep/ are never pruned.
KEEP_AUDIO=false
KEEP_AUDIO_MAX=100
# Say any of these while dictating -> clip is filed permanently in
# api/audio_corpus/keep/ named with the phrase. Add a category by adding a
# phrase. The phrase is NOT removed from your transcript.
# Keep more specific phrases BEFORE the words they contain: the first match wins
# and becomes the label, so "loud in here" must precede bare "loud".
CORPUS_TAG_TRIGGERS=tag this clip,loud in here,restaurant test,outdoor test,crowd test,loud
# Clips the decoder struggled on auto-file into audio_corpus/hard/ (capped).
# -0.25 = 5th percentile of 414 real clips; median is -0.128.
KEEP_AUDIO_PIN_BELOW=-0.25
KEEP_AUDIO_HARD_MAX=50
# wlogp rises with clip length (corr +0.55), so the threshold is applied to a
# length-adjusted score -- otherwise hard/ collects short clips, not hard ones.
# Each clip is restated as if it were REF_DUR seconds long, at SLOPE wlogp per
# natural-log unit of duration. Set SLOPE=0 for the old raw-wlogp behaviour.
KEEP_AUDIO_PIN_REF_DUR=15.0
KEEP_AUDIO_PIN_DUR_SLOPE=0.05
